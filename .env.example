# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=put-your-google-ai-studio-key-here
# gemini-2.0-flash is retired on current keys; this is the model that works.
GEMINI_MODEL=gemini-flash-lite-latest

# Optional: set both values to use Qdrant Cloud instead of the local index.
# Leave blank to use the local Qdrant database.
QDRANT_URL=
QDRANT_API_KEY=

# Paper-reported parameters (defaults already match the paper)
TAU=0.65
MAX_ITERS=3
TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=64
