# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=put-your-google-ai-studio-key-here
# gemini-2.0-flash is retired on current keys; this is the model that works.
GEMINI_MODEL=gemini-flash-lite-latest

# Optional: set both values to use Qdrant Cloud instead of the local index.
# Leave blank to use the local Qdrant database.
QDRANT_URL=
QDRANT_API_KEY=

# Paper-reported parameters (defaults already match the paper)
TAU=0.65
MAX_ITERS=3
TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Retrieval (Phase 4, paper Table 2 / Fig. 5): similarity threshold tau for
# evidence selection, and query term boosting. Both default to paper values.
# RETRIEVAL_THRESHOLD=0.65
# TERM_BOOST=1

# Clinical Text Clarifier - ICD-10-CM terminology mapping via the free NLM
# Clinical Tables API (no key needed). SNOMED CT is deferred (licence required).
# ICD10_ENABLED=1
# ICD10_MAX_QUERIES=8

# --- Phase 5: external web evidence (paper Sec. II-A-3) -----------------------
# Serper.dev web search (free tier: register at https://serper.dev, no card).
# Paste YOUR key after the = yourself - never share it in chat or commit it.
# Without a key the system still runs: PubMed and NICE are keyless, and the log
# records that Serper was skipped. Responses are disk-cached in
# results/serper_cache/ so reruns are reproducible and spend no credits.
# SERPER_API_KEY=
# SERPER_ENABLED=1
# NICE_ENABLED=1             # direct keyless search on nice.org.uk
# SCANNER_WEB_SUMMARY=1       # one LLM pass summarising the returned web pages

# --- Per-agent model configuration (all five agents default to Gemini above) --
# Each agent can independently point at another provider/model later, e.g.:
#
#   RAG_ANALYZER_PROVIDER=groq
#   RAG_ANALYZER_MODEL=llama-3.3-70b-versatile
#   GROQ_API_KEY=your-groq-key
#
# Agents: CLARIFIER, RAG_ANALYZER, EVIDENCE_SCANNER, FUSION, OPTIMIZER, SELECT.
# Options per agent: <AGENT>_PROVIDER (default gemini) and <AGENT>_MODEL.
# Credentials are read from <PROVIDER>_API_KEY (+ optional <PROVIDER>_BASE_URL
# for providers that are not in the built-in list: openai, groq, openrouter,
# together, mistral, deepseek, xai, cerebras, perplexity).
# If an optional provider fails or its key is missing, that agent automatically
# falls back to Gemini - one GEMINI_API_KEY is always enough to run the system.
# Leave everything commented out to keep the default single-Gemini setup.
# LLM_PROVIDER=gemini
# CLARIFIER_PROVIDER=
# CLARIFIER_MODEL=
# RAG_ANALYZER_PROVIDER=
# RAG_ANALYZER_MODEL=
# EVIDENCE_SCANNER_PROVIDER=
# EVIDENCE_SCANNER_MODEL=
# FUSION_PROVIDER=
# FUSION_MODEL=
# OPTIMIZER_PROVIDER=
# OPTIMIZER_MODEL=
# SELECT_PROVIDER=
# SELECT_MODEL=
